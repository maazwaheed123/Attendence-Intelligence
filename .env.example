# Copy to .env for local development. Never commit .env.
# Everything runs locally: no API keys are needed.

APP_ENV=dev
LOG_LEVEL=INFO

# --- auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
JWT_TTL_MIN=60

# --- Postgres (container) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL_OWNER=postgresql+psycopg://postgres:change-me@postgres:5432/attendance
DATABASE_URL_APP=postgresql+psycopg://app_rw:change-me-app@postgres:5432/attendance
DATABASE_URL_READER=postgresql+psycopg://rag_reader:change-me-reader@postgres:5432/attendance

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- PII encryption (Fernet key; generate in Step 2) ---
PII_ENCRYPTION_KEY=

# --- ingestion ---
INGEST_SYNC=false
MAX_UPLOAD_MB=20

# --- LLM chain: local Ollama running natively on the host ---
LLM_CHAIN=ollama-primary,ollama-fallback,template
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:3b
LLM_TIMEOUT_S=90
VISION_TIMEOUT_S=600
BREAKER_FAILS=3
BREAKER_RESET_S=60

# --- retrieval / governance ---
EMBEDDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
RERANK_MODEL=BAAI/bge-reranker-base
OCR_REVIEW_THRESHOLD=0.75
FEEDBACK_MATCH_THRESHOLD=0.85
CONF_HIGH=0.85
CONF_LOW=0.60
CACHE_TTL_S=600
RATE_LIMIT_PER_MIN=60
