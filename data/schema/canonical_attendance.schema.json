{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/canonical_attendance.schema.json",
  "title": "CanonicalAttendanceRecord",
  "description": "One normalized attendance fact, traceable to its source and carrying isolation context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "attendance_date", "employee_id", "employee_name", "department", "entity_id",
    "status", "source_document_id", "source_file", "source_locator", "extraction_method",
    "extraction_confidence", "review_required", "product_id", "tenant_id", "module", "classification"
  ],
  "properties": {
    "record_id": { "type": "string", "format": "uuid", "description": "UUIDv5(document checksum + locator): deterministic, makes reprocessing idempotent" },
    "attendance_date": { "type": "string", "format": "date" },
    "employee_id": { "type": "string", "minLength": 1 },
    "employee_name": { "type": "string", "minLength": 1 },
    "department": { "type": "string" },
    "entity_id": { "type": "string", "description": "Protected entity (department / business unit)" },
    "status": { "enum": ["present", "absent", "leave", "holiday", "wfh", "half_day", "unknown"] },
    "check_in": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
    "check_out": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
    "total_hours": { "type": ["number", "null"], "minimum": 0, "maximum": 24 },
    "source_document_id": { "type": "string", "format": "uuid" },
    "source_file": { "type": "string" },
    "source_locator": { "type": "string", "examples": ["row=5", "sheet=Sep 1-15;row=7", "page=2;table=1;row=4", "table=1;row=3;col=Tue 08/09", "page=1;row=3"] },
    "raw_values": { "type": "object", "description": "Original cell / OCR text per field" },
    "extraction_method": { "enum": ["csv", "xlsx", "docx", "pdf_text", "ocr_tesseract", "ocr_vision", "ocr_reconciled"] },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_required": { "type": "boolean" },
    "review_reasons": { "type": "array", "items": { "type": "string" } },
    "is_active": { "type": "boolean", "description": "false once superseded by a newer version of the source file" },
    "product_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "module": { "const": "attendance" },
    "classification": { "enum": ["public", "internal", "confidential", "restricted"] }
  }
}
